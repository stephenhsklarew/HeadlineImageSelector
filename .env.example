# Example environment variables for HeadlineImageSelector
# Copy this file to .env and fill in your values

# Optional: Set custom config path
# CONFIG_PATH=config/my_config.yaml

# Optional: Google Drive credentials
# (By default, looks for credentials.json and token_drive.json in project root)
# GOOGLE_CREDENTIALS_PATH=path/to/credentials.json
# GOOGLE_TOKEN_PATH=path/to/token.json
